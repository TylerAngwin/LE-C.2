//Do not change the port declarations
module function_unit (result, V, C, N, Z, OpA, OpB, FS);
  input [3:0] FS;
  input [7:0] OpA, OpB;
  output [7:0] result;
  output V, C, N, Z;

  //select bits
  wire f3, f2, f1, f0;
  assign f3 = FS[3];
  assign f2 = FS[2];
  assign f1 = FS[1];
  assign f0 = FS[0];

  wire f2_n, f1_n, f0_n;
  wire inv_a_n;
  wire inv_b_n;
  wire c0;
  wire not_f3_f1;
  wire not_f3_f0;
  wire not_f3_f1_f0;
  wire pass_b_3;
  wire pass_b_hi;
  wire shift_n;
  wire lsl_en;
  wire lsr_en;
  wire nor_en_n;

  //block outputs, active low
  wire [7:0] sum_n;
  wire [7:0] nor_n;
  wire [7:1] lsl_n;
  wire [6:0] lsr_n;
  wire zero_lo;
  wire zero_hi;

  //control circuit
  not i_f2 (f2_n, f2);
  not i_f1 (f1_n, f1);
  not i_f0 (f0_n, f0);

  //block 1: operand gating, inversion and carry in (pass_a = f3, pass_b_lo = f2)
  nand na_ia  (inv_a_n, f3, f1);
  nand na_ib  (inv_b_n, f2, f0, inv_a_n);
  nor  n_31   (not_f3_f1, f3, f1);
  nor  n_c0   (c0, f0_n, not_f3_f1);
  nor  n_30   (not_f3_f0, f3, f0);
  nor  n_pbh  (pass_b_hi, f2_n, not_f3_f0);
  nor  n_310  (not_f3_f1_f0, f3, f1, f0);
  nor  n_pb3  (pass_b_3, f2_n, not_f3_f1_f0);
  
  //blocks 2 and 3 are enables
  or   o_sh   (shift_n, f3, f2, f0);
  nor  n_lsl  (lsl_en, shift_n, f1);
  nor  n_lsr  (lsr_en, shift_n, f1_n);
  nand na_nor (nor_en_n, f2_n, f1_n, f0);

  //functional blocks
  //sum_n, C, V, OpA, OpB, pass_a, inv_a_n, pass_b_lo, pass_b_3, pass_b_hi,inv_b_n, c0
  arith_block blk1 (sum_n, C, V, OpA, OpB, f3, inv_a_n, f2, pass_b_3, pass_b_hi, inv_b_n, c0);

  //nor_n, OpA, OpB, nor_en_n
  logic_block blk2 (nor_n, OpA, OpB, nor_en_n);

  //lsl_n, lsr_n, OpB, lsl_en, lsr_en
  shift_block blk3 (lsl_n, lsr_n, OpB, lsl_en, lsr_en);

  nand na_r0  (result[0], sum_n[0], nor_n[0],           lsr_n[0]);
  nand na_r1  (result[1], sum_n[1], nor_n[1], lsl_n[1], lsr_n[1]);
  nand na_r2  (result[2], sum_n[2], nor_n[2], lsl_n[2], lsr_n[2]);
  nand na_r3  (result[3], sum_n[3], nor_n[3], lsl_n[3], lsr_n[3]);
  nand na_r4  (result[4], sum_n[4], nor_n[4], lsl_n[4], lsr_n[4]);
  nand na_r5  (result[5], sum_n[5], nor_n[5], lsl_n[5], lsr_n[5]);
  nand na_r6  (result[6], sum_n[6], nor_n[6], lsl_n[6], lsr_n[6]);
  nand na_r7  (result[7], sum_n[7], nor_n[7], lsl_n[7]);

  nand na_n   (N, sum_n[7], nor_n[7]);
  nor  n_zlo  (zero_lo, result[3], result[2], result[1], result[0]);
  nor  n_zhi  (zero_hi, result[7], result[6], result[5], result[4]);
  and  a_z    (Z, zero_lo, zero_hi, shift_n);

endmodule


//block 1
module arith_block (sum_n, C, V, OpA, OpB, pass_a, inv_a_n, pass_b_lo, pass_b_3, pass_b_hi,
                    inv_b_n, c0);
  output [7:0] sum_n;// complemented sum
  output C;
  output V;
  input [7:0] OpA, OpB;
  input pass_a;
  input  inv_a_n;
  input  pass_b_lo;
  input pass_b_3;
  input pass_b_hi;
  input inv_b_n;
  input  c0;

  wire [7:0] a_n; // (OpA AND pass_a)'
  wire [7:0] b_n; // (OpB AND pass_b)'
  wire [7:0] X; //a input to the adder
  wire [7:0] Y; //b input to the adder
  wire [6:0] c; //c[i] is the carry out of bit i
  wire pass_b_hi_n; //complement of pass_b_hi
  wire rem_neg_n; //0 only for rem16 with B negative
  wire low_zero; //1 when B[3:0] = 0000
  wire fill_n; //0 when bits 7-4 of the rem16 result must be 1
  wire inv_b_hi; //1 = invert Y bits 7-4 (or supply the rem16 fill)

  // X = OpA, OpA' or 0:  NAND(OpA, pass_a) XOR inv_a' = (OpA AND pass_a) XOR inv_a
  nand na_a0 (a_n[0], OpA[0], pass_a);
  nand na_a1 (a_n[1], OpA[1], pass_a);
  nand na_a2 (a_n[2], OpA[2], pass_a);
  nand na_a3 (a_n[3], OpA[3], pass_a);
  nand na_a4 (a_n[4], OpA[4], pass_a);
  nand na_a5 (a_n[5], OpA[5], pass_a);
  nand na_a6 (a_n[6], OpA[6], pass_a);
  nand na_a7 (a_n[7], OpA[7], pass_a);
  xor  x_x0  (X[0], a_n[0], inv_a_n);
  xor  x_x1  (X[1], a_n[1], inv_a_n);
  xor  x_x2  (X[2], a_n[2], inv_a_n);
  xor  x_x3  (X[3], a_n[3], inv_a_n);
  xor  x_x4  (X[4], a_n[4], inv_a_n);
  xor  x_x5  (X[5], a_n[5], inv_a_n);
  xor  x_x6  (X[6], a_n[6], inv_a_n);
  xor  x_x7  (X[7], a_n[7], inv_a_n);

  //y bits 3-0 = OpB, OpB' or 0 (bit 3 has its own pass signal so mod8 can clear it)
  nand na_b0 (b_n[0], OpB[0], pass_b_lo);
  nand na_b1 (b_n[1], OpB[1], pass_b_lo);
  nand na_b2 (b_n[2], OpB[2], pass_b_lo);
  nand na_b3 (b_n[3], OpB[3], pass_b_3);
  xor  x_y0  (Y[0], b_n[0], inv_b_n);
  xor  x_y1  (Y[1], b_n[1], inv_b_n);
  xor  x_y2  (Y[2], b_n[2], inv_b_n);
  xor  x_y3  (Y[3], b_n[3], inv_b_n);

  // rem16 sign fill
  not  i_pbh  (pass_b_hi_n, pass_b_hi);
  nand na_neg (rem_neg_n, pass_b_3, pass_b_hi_n, OpB[7]);
  nor  n_low  (low_zero, OpB[3], OpB[2], OpB[1], OpB[0]);
  or   o_fill (fill_n, low_zero, rem_neg_n);
  nand na_ibh (inv_b_hi, inv_b_n, fill_n);

  //y bits 7-4 = OpB, OpB', 0 or the rem16
  nand na_b4 (b_n[4], OpB[4], pass_b_hi);
  nand na_b5 (b_n[5], OpB[5], pass_b_hi);
  nand na_b6 (b_n[6], OpB[6], pass_b_hi);
  nand na_b7 (b_n[7], OpB[7], pass_b_hi);
  xnor xn_y4 (Y[4], b_n[4], inv_b_hi);
  xnor xn_y5 (Y[5], b_n[5], inv_b_hi);
  xnor xn_y6 (Y[6], b_n[6], inv_b_hi);
  xnor xn_y7 (Y[7], b_n[7], inv_b_hi);

  //8bit ripple CA
  full_adder fa0 (sum_n[0], c[0], X[0], Y[0], c0);
  full_adder fa1 (sum_n[1], c[1], X[1], Y[1], c[0]);
  full_adder fa2 (sum_n[2], c[2], X[2], Y[2], c[1]);
  full_adder fa3 (sum_n[3], c[3], X[3], Y[3], c[2]);
  full_adder fa4 (sum_n[4], c[4], X[4], Y[4], c[3]);
  full_adder fa5 (sum_n[5], c[5], X[5], Y[5], c[4]);
  full_adder fa6 (sum_n[6], c[6], X[6], Y[6], c[5]);
  full_adder fa7 (sum_n[7], C,    X[7], Y[7], c[6]);

  //overflow
  xor  x_v    (V, c[6], C);

endmodule


//full adder
module full_adder (sum_n, cout, a, b, cin);
  output sum_n, cout;
  input  a, b, cin;

  wire p;//a XOR b
  wire g_n;//(a AND b)'
  wire t_n;//(p AND cin)'
  xor  x_p  (p, a, b);
  xnor x_s  (sum_n, p, cin);
  nand na_g (g_n, a, b);
  nand na_t (t_n, p, cin);
  nand na_c (cout, g_n, t_n);

endmodule

//block 2
module logic_block (nor_n, OpA, OpB, nor_en_n);
  output [7:0] nor_n;      // complemented nor term
  input  [7:0] OpA, OpB;
  input        nor_en_n;   // 0 = nor is selected

  or o_n0 (nor_n[0], OpA[0], OpB[0], nor_en_n);
  or o_n1 (nor_n[1], OpA[1], OpB[1], nor_en_n);
  or o_n2 (nor_n[2], OpA[2], OpB[2], nor_en_n);
  or o_n3 (nor_n[3], OpA[3], OpB[3], nor_en_n);
  or o_n4 (nor_n[4], OpA[4], OpB[4], nor_en_n);
  or o_n5 (nor_n[5], OpA[5], OpB[5], nor_en_n);
  or o_n6 (nor_n[6], OpA[6], OpB[6], nor_en_n);
  or o_n7 (nor_n[7], OpA[7], OpB[7], nor_en_n);

endmodule

//block 3
module shift_block (lsl_n, lsr_n, OpB, lsl_en, lsr_en);
  output [7:1] lsl_n;//(B[i-1] AND lsl_en)'
  output [6:0] lsr_n;//(B[i+1] AND lsr_en)'
  input  [7:0] OpB;
  input lsl_en;//1 = lslB
  input lsr_en;//1 = lsrB

  nand na_l1 (lsl_n[1], OpB[0], lsl_en);
  nand na_l2 (lsl_n[2], OpB[1], lsl_en);
  nand na_l3 (lsl_n[3], OpB[2], lsl_en);
  nand na_l4 (lsl_n[4], OpB[3], lsl_en);
  nand na_l5 (lsl_n[5], OpB[4], lsl_en);
  nand na_l6 (lsl_n[6], OpB[5], lsl_en);
  nand na_l7 (lsl_n[7], OpB[6], lsl_en);
  nand na_r0 (lsr_n[0], OpB[1], lsr_en);
  nand na_r1 (lsr_n[1], OpB[2], lsr_en);
  nand na_r2 (lsr_n[2], OpB[3], lsr_en);
  nand na_r3 (lsr_n[3], OpB[4], lsr_en);
  nand na_r4 (lsr_n[4], OpB[5], lsr_en);
  nand na_r5 (lsr_n[5], OpB[6], lsr_en);
  nand na_r6 (lsr_n[6], OpB[7], lsr_en);

endmodule

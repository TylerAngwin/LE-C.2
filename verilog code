//Do not change the port declarations
module function_unit (result, V, C, N, Z, OpA, OpB, FS);
  input [3:0] FS;
  input [7:0] OpA, OpB;
  output [7:0] result;
  output V, C, N, Z;

 // 1. Subcircuit Instantiations (3 Functional Blocks)  
 // Block 0: Arithmetic Operations (FS = 0000 to 0101)
    wire [7:0] res_arith;
    wire       v_arith, c_arith;
    arith_circuit b_arith (res_arith, v_arith, c_arith, OpA, OpB, FS[2:0]);

// Block 1: Bitwise Logic & Shift Left (FS = 1000 to 1011)
    wire [7:0] res_logic;
    logic_circuit b_logic (res_logic, OpA, OpB, FS[1:0]);

// Block 2: Remainder, Modulus & Shift Right (FS = 1100 to 1110)
    wire [7:0] res_special;
    special_circuit b_special (res_special, OpB, FS[1:0]);

// 2. High-Level Block Selection Logic
    wire fs3_n, fs2_n, fs1_n;
    not (fs3_n, FS[3]);
    not (fs2_n, FS[2]);
    not (fs1_n, FS[1]);

// Arithmetic block is valid when FS[3] == 0 and FS[2:0] <= 5 (i.e., not 0110 or 0111)
    wire not_fs2_or_not_fs1;
    wire arith_valid;
    or  (not_fs2_or_not_fs1, fs2_n, fs1_n);
    and (arith_valid, fs3_n, not_fs2_or_not_fs1);

// Logic block is valid when FS[3:2] == 2'b10
    wire sel_logic;
    and (sel_logic, FS[3], fs2_n);

// Special block is valid when FS[3:2] == 2'b11 and FS[1:0] != 2'b11
    wire special_valid, sel_special;
    nand (special_valid, FS[1], FS[0]);
    and  (sel_special, FS[3], FS[2], special_valid);

// Multiplex final 8-bit result across all 3 functional blocks
    assign result = (res_arith   & {8{arith_valid}}) |
                    (res_logic   & {8{sel_logic}})   |
                    (res_special & {8{sel_special}});

// 3. Status Bits (V, C, N, Z) Logic

// V and C are active ONLY for arithmetic operations; 0 for all others
    assign V = v_arith & arith_valid;
    assign C = c_arith & arith_valid;

// Both shift operations (lslB: 1011 and lsrB: 1110) clear ALL status bits
    wire is_lslB, is_lsrB, clear_status;
    and (is_lslB, FS[3], fs2_n, FS[1], FS[0]);
    and (is_lsrB, FS[3], FS[2], FS[1], ~FS[0]);
    or  (clear_status, is_lslB, is_lsrB);

//MSB of active result, forced to 0 if clear_status is asserted
    assign N = result[7] & ~clear_status;

// 1 when all bits of result are 0, forced to 0 if clear_status is asserted
    wire result_is_zero;
    assign result_is_zero = ~(|result);
    assign Z = result_is_zero & ~clear_status;

endmodule


// Submodule 1: arith_circuit
module arith_circuit (result, V, C, OpA, OpB, opselect);
    input  [2:0] opselect;
    input  [7:0] OpA, OpB;
    output [7:0] result;
    output       V, C;

    // 3-to-8 decoder for local operation selection
    wire s2_n, s1_n, s0_n;
    not (s2_n, opselect[2]);
    not (s1_n, opselect[1]);
    not (s0_n, opselect[0]);

    wire is_mova, is_add, is_sub, is_decA, is_negA, is_incB;
    and (is_mova, s2_n, s1_n, s0_n);         // 000: mova
    and (is_add,  s2_n, s1_n, opselect[0]);  // 001: add
    and (is_sub,  s2_n, opselect[1], s0_n);  // 010: subab
    and (is_decA, s2_n, opselect[1], opselect[0]); // 011: decA
    and (is_negA, opselect[2], s1_n, s0_n);  // 100: negA
    and (is_incB, opselect[2], s1_n, opselect[0]); // 101: incB

// C0 = 1 for subtraction, 2's complement negation, and increment
    wire c0;
    or (c0, is_sub, is_negA, is_incB);

// Steering logic for Adder input X
    wire sel_opA_x;
    or (sel_opA_x, is_mova, is_add, is_sub, is_decA);
    wire [7:0] X;
    assign X = OpA & {8{sel_opA_x}};

// Steering logic for Adder input Y
    wire [7:0] notB, notA;
    assign notB = ~OpB;
    assign notA = ~OpA;

    wire [7:0] Y;
    assign Y = (OpB   & {8{is_add | is_incB}}) |
               (notB  & {8{is_sub}})           |
               (notA  & {8{is_negA}})          |
               (8'hFF & {8{is_decA}});

// 8-bit Ripple-Carry Adder constructed with 1-bit Full Adders
    wire [7:0] c_wire;
    full_adder fa0 (result[0], c_wire[0], X[0], Y[0], c0);
    full_adder fa1 (result[1], c_wire[1], X[1], Y[1], c_wire[0]);
    full_adder fa2 (result[2], c_wire[2], X[2], Y[2], c_wire[1]);
    full_adder fa3 (result[3], c_wire[3], X[3], Y[3], c_wire[2]);
    full_adder fa4 (result[4], c_wire[4], X[4], Y[4], c_wire[3]);
    full_adder fa5 (result[5], c_wire[5], X[5], Y[5], c_wire[4]);
    full_adder fa6 (result[6], c_wire[6], X[6], Y[6], c_wire[5]);
    full_adder fa7 (result[7], c_wire[7], X[7], Y[7], c_wire[6]);

// Carry-out from MSB stage
    assign C = c_wire[7];

// Two's complement overflow: V = C_out XOR C_in of MSB
    xor (V, c_wire[7], c_wire[6]);

endmodule


// Submodule 2: logic_circuit 
module logic_circuit (result, OpA, OpB, opselect);
    input  [1:0] opselect;
    input  [7:0] OpA, OpB;
    output [7:0] result;

    wire s1_n, s0_n;
    not (s1_n, opselect[1]);
    not (s0_n, opselect[0]);

    wire sel_or, sel_notA, sel_notB, sel_lslB;
    and (sel_or,   s1_n,        s0_n);        // 00 -> or
    and (sel_notA, s1_n,        opselect[0]); // 01 -> notA
    and (sel_notB, opselect[1], s0_n);        // 10 -> notB
    and (sel_lslB, opselect[1], opselect[0]); // 11 -> lslB

    wire [7:0] res_or   = OpA | OpB;
    wire [7:0] res_notA = ~OpA;
    wire [7:0] res_notB = ~OpB;
    wire [7:0] res_lslB = {OpB[6:0], 1'b0};   // 0 logic gates (bus rewiring)

    assign result = (res_or   & {8{sel_or}})   |
                    (res_notA & {8{sel_notA}}) |
                    (res_notB & {8{sel_notB}}) |
                    (res_lslB & {8{sel_lslB}});

endmodule



// Submodule 3: special_circuit 
module special_circuit (result, OpB, opselect);
    input  [1:0] opselect;
    input  [7:0] OpB;
    output [7:0] result;

    wire s1_n, s0_n;
    not (s1_n, opselect[1]);
    not (s0_n, opselect[0]);

    wire sel_rem16, sel_mod8, sel_lsrB;
    and (sel_rem16, s1_n,        s0_n);        // 00 -> rem16
    and (sel_mod8,  s1_n,        opselect[0]); // 01 -> mod8
    and (sel_lsrB,  opselect[1], s0_n);        // 10 -> lsrB

    // rem16: Truncation toward 0 (preserves sign of B when lower bits != 0)
    wire lower4_has_ones;
    assign lower4_has_ones = |OpB[3:0];
    wire rem_sign_bit;
    assign rem_sign_bit = OpB[7] & lower4_has_ones;
    wire [7:0] res_rem16;
    assign res_rem16 = {{4{rem_sign_bit}}, OpB[3:0]};

    // mod8: Floor toward -infinity (lower 3 bits zero-extended)
    wire [7:0] res_mod8;
    assign res_mod8 = {5'b00000, OpB[2:0]};

    // lsrB: Logical shift right by 1 bit (0 logic gates, bus rewiring)
    wire [7:0] res_lsrB;
    assign res_lsrB = {1'b0, OpB[7:1]};

    assign result = (res_rem16 & {8{sel_rem16}}) |
                    (res_mod8  & {8{sel_mod8}})  |
                    (res_lsrB  & {8{sel_lsrB}});

endmodule



// Submodule 4: full_adder 
module full_adder (s, cout, a, b, cin);
    input  a, b, cin;
    output s, cout;

    wire w1, w2, w3;
    xor (w1, a, b);
    xor (s, w1, cin);

    and (w2, w1, cin);
    and (w3, a, b);
    or  (cout, w2, w3);

endmodule
